# Copy to .env and add your key. Without it, every LLM feature uses templates (demo still works).
GEMINI_API_KEY=
# Optional: override the model (the committed LLM cache was warmed with this one)
GEMINI_MODEL=gemini-3.5-flash-lite
# Demo mode: one-click, password-free login as HR or a synthetic member. Never enable on a shared deployment.
NESTMATE_DEMO=1
